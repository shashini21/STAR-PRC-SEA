@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>KOMAR FORMAT - FOB</title>

    <link rel="stylesheet"
          href="~/css/komar-fob.css" />
</head>

<body>

    <div class="page-container">

        <div class="komar-card">

            <!-- =========================================================
         HEADER
         ========================================================= -->

            <div class="komar-header">

                <div class="header-left">

                    <div class="header-icon">
                        F
                    </div>

                    <div>

                        <div class="header-breadcrumb">
                            TRANSACTION FILES
                        </div>

                        <h1>
                            KOMAR FORMAT - FOB
                        </h1>

                        <p>
                            FOB Costing and Style Management
                        </p>

                    </div>

                </div>

                <button type="button"
                        class="header-close"
                        onclick="closeForm()">
                    ×
                </button>

            </div>


            <!-- =========================================================
         PAGE NAVIGATION
         ========================================================= -->

            <div class="page-navigation">

                <button type="button"
                        class="page-tab active"
                        onclick="showPage(1)">

                    <span class="page-number">01</span>

                    <span>Style</span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(2)">

                    <span class="page-number">02</span>

                    <span>Costing</span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(3)">

                    <span class="page-number">03</span>

                    <span>Profit</span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(4)">

                    <span class="page-number">04</span>

                    <span>Basic Trims</span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(5)">

                    <span class="page-number">05</span>

                    <span>Confirmation</span>

                </button>

            </div>


            <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

            <div class="page-content">


                <!-- =====================================================
             PAGE 1
             ===================================================== -->

                <section class="form-page active-page"
                         id="page1">

                    <div class="page-title">

                        <h2>
                            Style Information
                        </h2>

                        <p>
                            Enter the basic FOB style information and select
                            the revision you want to modify.
                        </p>

                    </div>


                    <!-- BASIC INFORMATION -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                01
                            </span>

                            <div>

                                <h3>
                                    Basic Information
                                </h3>

                                <p>
                                    Style, account and revision information
                                </p>

                            </div>

                        </div>


                        <div class="form-grid">


                            <!-- STYLE -->

                            <div class="form-field">

                                <label>
                                    Style No
                                </label>

                                <div class="input-with-button">

                                    <input type="text"
                                           id="styleNumber"
                                           placeholder="Enter style number" />

                                    <button type="button"
                                            class="search-button"
                                            onclick="openRevisionModal()">

                                        ⋯

                                    </button>

                                </div>

                            </div>


                            <!-- CREATE DATE -->

                            <div class="form-field">

                                <label>
                                    Create Date
                                </label>

                                <input type="date"
                                       id="createDate" />

                            </div>


                            <!-- REF -->

                            <div class="form-field">

                                <label>
                                    Ref #
                                </label>

                                <input type="text"
                                       id="refNo"
                                       placeholder="Enter reference" />

                            </div>


                            <!-- COSTING -->

                            <div class="form-field">

                                <label>
                                    Costing
                                </label>

                                <div class="costing-input">

                                    <select id="costingStatus">

                                        <option value="">
                                            Select
                                        </option>

                                        <option value="SIGNED">
                                            SIGNED
                                        </option>

                                        <option value="UNSIGNED">
                                            UNSIGNED
                                        </option>

                                    </select>

                                    <input type="text"
                                           id="costingRevision"
                                           value="00"
                                           readonly />

                                </div>

                            </div>


                            <!-- DISPLAY STYLE -->

                            <div class="form-field wide">

                                <label>
                                    Display Style
                                </label>

                                <input type="text"
                                       id="displayStyle"
                                       placeholder="Enter display style" />

                            </div>


                            <!-- ACCOUNT -->

                            <div class="form-field">

                                <label>
                                    Account
                                </label>

                                <input type="text"
                                       id="accountNo"
                                       placeholder="Enter account number" />

                            </div>


                            <!-- FABRIC GROUP -->

                            <div class="form-field">

                                <label>
                                    Fabric Group
                                </label>

                                <input type="text"
                                       id="fabricGroup"
                                       placeholder="Fabric group" />

                            </div>


                            <!-- COUNTRY -->

                            <div class="form-field">

                                <label>
                                    Country
                                </label>

                                <input type="text"
                                       id="country"
                                       value="SRI LANKA" />

                            </div>


                            <!-- CATEGORY -->

                            <div class="form-field">

                                <label>
                                    Category
                                </label>

                                <input type="text"
                                       id="category"
                                       placeholder="Category" />

                            </div>


                            <!-- SEASON -->

                            <div class="form-field">

                                <label>
                                    Season
                                </label>

                                <input type="text"
                                       id="season"
                                       placeholder="Season" />

                            </div>


                            <!-- REVISION -->

                            <div class="form-field">

                                <label>
                                    Rev No
                                </label>

                                <input type="text"
                                       id="revisionNo"
                                       placeholder="Select revision"
                                       readonly />

                            </div>


                            <!-- DESCRIPTION -->

                            <div class="form-field wide">

                                <label>
                                    Description
                                </label>

                                <input type="text"
                                       id="description"
                                       placeholder="Style description" />

                            </div>


                            <!-- QUOTE -->

                            <div class="form-field">

                                <label>
                                    Quote
                                </label>

                                <input type="number"
                                       step="0.0001"
                                       placeholder="0.0000" />

                            </div>


                            <!-- X FACTORY -->

                            <div class="form-field">

                                <label>
                                    X'Fty Date
                                </label>

                                <input type="date" />

                            </div>


                            <!-- DUTY -->

                            <div class="form-field">

                                <label>
                                    Duty Rate
                                </label>

                                <input type="number"
                                       step="0.0001"
                                       placeholder="0.0000" />

                            </div>


                            <!-- FTY DUTY -->

                            <div class="form-field">

                                <label>
                                    FTY Duty Rate
                                </label>

                                <input type="number"
                                       step="0.0001"
                                       placeholder="0.0000" />

                            </div>


                            <!-- KG RATE -->

                            <div class="form-field">

                                <label>
                                    KG Rate
                                </label>

                                <input type="number"
                                       step="0.0001"
                                       placeholder="0.0000" />

                            </div>


                            <!-- QUOTE RATE -->

                            <div class="form-field">

                                <label>
                                    Quote Rate
                                </label>

                                <input type="number"
                                       step="0.0001"
                                       placeholder="0.0000" />

                            </div>


                            <!-- GMTS -->

                            <div class="form-field">

                                <label>
                                    Gmts In Pack
                                </label>

                                <input type="number"
                                       placeholder="0" />

                            </div>


                            <!-- BRAND -->

                            <div class="form-field">

                                <label>
                                    Brand / Label
                                </label>

                                <input type="text"
                                       placeholder="Brand / Label" />

                            </div>


                            <!-- COLOR -->

                            <div class="form-field">

                                <label>
                                    Color
                                </label>

                                <input type="text"
                                       placeholder="Color" />

                            </div>


                            <!-- SIZES -->

                            <div class="form-field wide">

                                <label>
                                    Sizes
                                </label>

                                <input type="text"
                                       placeholder="Sizes" />

                            </div>


                            <!-- PROJECTED -->

                            <div class="form-field">

                                <label>
                                    Projected Units
                                </label>

                                <input type="number"
                                       placeholder="0" />

                            </div>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="section-card">

                        <div class="status-section">

                            <span class="status-label">
                                Style Status
                            </span>

                            <label class="radio-option">

                                <input type="radio"
                                       name="styleStatus"
                                       checked />

                                Active

                            </label>

                            <label class="radio-option">

                                <input type="radio"
                                       name="styleStatus" />

                                Inactive

                            </label>

                        </div>

                    </div>


                    <!-- FABRIC -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                02
                            </span>

                            <div>

                                <h3>
                                    Fabric Details
                                </h3>

                                <p>
                                    Fabric and customer payment information
                                </p>

                            </div>

                        </div>


                        <div class="table-wrapper">

                            <table class="data-table">

                                <thead>

                                    <tr>

                                        <th>No</th>
                                        <th>Type</th>
                                        <th>Fabric</th>
                                        <th>Customer Paid</th>
                                        <th>Contract</th>
                                        <th>Price</th>
                                        <th>Fabric Content</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @for (int i = 1; i <= 8; i++)
                                    {
                                        <tr>

                                            <td>@i</td>

                                            <td>
                                                <input type="text" />
                                            </td>

                                            <td>
                                                <input type="text" />
                                            </td>

                                            <td class="center">
                                                <input type="checkbox" />
                                            </td>

                                            <td>
                                                <input type="text" />
                                            </td>

                                            <td>
                                                <input type="number" />
                                            </td>

                                            <td>
                                                <input type="text" />
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <div class="table-actions">

                            <button type="button"
                                    class="secondary-button">
                                + Add Line
                            </button>

                            <button type="button"
                                    class="danger-button">
                                − Delete Line
                            </button>

                        </div>

                    </div>


                    <!-- SKETCH -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                03
                            </span>

                            <div>

                                <h3>
                                    Style Sketch
                                </h3>

                                <p>
                                    Style sketch / image
                                </p>

                            </div>

                        </div>


                        <div class="sketch-area">

                            <div class="sketch-placeholder">

                                <div class="sketch-icon">
                                    +
                                </div>

                                <strong>
                                    No sketch uploaded
                                </strong>

                                <span>
                                    Add a style sketch later
                                </span>

                            </div>

                        </div>


                        <div class="sketch-buttons">

                            <button type="button"
                                    class="secondary-button">
                                Paste Sketch
                            </button>

                            <button type="button"
                                    class="secondary-button">
                                Load Sketch
                            </button>

                        </div>

                    </div>

                </section>


                <
                    <!-- =========================================================
     PAGE 2 - FOB COSTING
     ========================================================= -->

                    <section class="form-page" id="page2">

                        <div class="page-title">
                            <h2>FOB Costing</h2>
                            <p>Factory costing, piecegoods, trims and additional FOB costing information.</p>
                        </div>


                        <!-- =====================================================
         MAIN COSTING AREA
         ===================================================== -->

                        <div class="fob-costing-layout">

                            <!-- LEFT SIDE -->
                            <div class="fob-costing-left">

                                <!-- Additional % + Factory Costing Table -->
                                <div class="foxpro-cost-table-card">

                                    <!-- Additional % -->
                                    <div class="additional-percent-bar">

                                        <div class="additional-label">
                                            Additional %
                                        </div>

                                        <input type="text"
                                               value="0.00"
                                               class="small-cost-input" />

                                        <input type="text"
                                               value="0.00"
                                               class="small-cost-input" />

                                    </div>


                                    <!-- Factory Costing Table -->
                                    <div class="costing-scroll-wrapper">

                                        <table class="foxpro-cost-table">

                                            <thead>
                                                <tr>
                                                    <th>No</th>
                                                    <th>Doz</th>
                                                    <th>Pcs</th>
                                                    <th class="yellow-header">Acct Air</th>
                                                    <th class="yellow-header">Acct Ves</th>
                                                    <th>Fty YC</th>
                                                    <th>Fty Price</th>
                                                    <th class="yellow-header">Fty Value</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                <tr class="active-cost-row">

                                                    <td>
                                                        <input type="text" value="1" />
                                                    </td>

                                                    <td>
                                                        <input type="text" value="0.0000" />
                                                    </td>

                                                    <td>
                                                        <input type="text" value="0.1770" />
                                                    </td>

                                                    <td class="yellow-cell">
                                                        <input type="text" value="1.5818" />
                                                    </td>

                                                    <td class="yellow-cell">
                                                        <input type="text" value="1.5818" />
                                                    </td>

                                                    <td>
                                                        <input type="text" value="0.1670" />
                                                    </td>

                                                    <td>
                                                        <input type="text" value="8.8470" />
                                                    </td>

                                                    <td class="yellow-cell">
                                                        <input type="text" value="1.4774" />
                                                    </td>

                                                </tr>


                                                <!-- Empty Rows -->
                                                @for (int i = 2; i <= 10; i++)
                                                {
                                                    <tr>

                                                        <td>
                                                            <input type="text" value="@i" />
                                                        </td>

                                                        <td>
                                                            <input type="text" />
                                                        </td>

                                                        <td>
                                                            <input type="text" />
                                                        </td>

                                                        <td class="yellow-cell">
                                                            <input type="text" />
                                                        </td>

                                                        <td class="yellow-cell">
                                                            <input type="text" />
                                                        </td>

                                                        <td>
                                                            <input type="text" />
                                                        </td>

                                                        <td>
                                                            <input type="text" />
                                                        </td>

                                                        <td class="yellow-cell">
                                                            <input type="text" />
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>


                                    <!-- Main Costing Summary -->

                                    <div class="main-costing-table">

                                        <div class="main-costing-header">
                                            <span></span>
                                            <span>Acct Air</span>
                                            <span>Acct Ves</span>
                                            <span>Fty Value</span>
                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Total Piecegoods Cost</strong>

                                            <input type="text" value="1.5818" />

                                            <input type="text" value="1.5818" />

                                            <input type="text" value="1.4774" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Labour</strong>

                                            <input type="text" value="2.0000" />

                                            <input type="text" value="2.0000" />

                                            <input type="text" value="1.4875" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Assist</strong>

                                            <input type="text" value="0.1330" />

                                            <input type="text" value="0.1330" />

                                            <input type="text" value="0.1330" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>ACCT Fixed Trims</strong>

                                            <input type="text" value="0.0000" />

                                            <input type="text" value="0.0000" />

                                            <input type="text" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Miscellaneous</strong>

                                            <input type="text" value="0.0000" />

                                            <input type="text" value="0.0000" />

                                            <input type="text" value="0.0640" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Washing</strong>

                                            <input type="text" value="0.0000" />

                                            <input type="text" value="0.0000" />

                                            <input type="text" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Non Dutiable</strong>

                                            <input type="text" />

                                            <input type="text" value="0.0000" />

                                            <input type="text" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Overhead</strong>

                                            <input type="text" value="0.0000" />

                                            <input type="text" value="0.0000" />

                                            <input type="text" />

                                        </div>


                                        <div class="main-costing-row">

                                            <strong>Trims</strong>

                                            <input type="text" value="0.20" />

                                            <input type="text" value="0.20" />

                                            <input type="text" value="0.1200" />

                                        </div>


                                        <!-- Sub Total -->

                                        <div class="subtotal-row">

                                            <strong>FOB Value XL</strong>

                                            <input type="text" value="3.280" />

                                            <span>Sub Totals</span>

                                            <input type="text" value="3.91" />

                                            <input type="text" value="3.91" />

                                            <input type="text" value="3.28" />

                                            <input type="text" value="3.28" />

                                        </div>

                                    </div>


                                    <!-- Bottom Cost Tables -->

                                    <div class="bottom-cost-tables">

                                        <!-- First table -->

                                        <div class="mini-cost-table">

                                            <table>

                                                <thead>
                                                    <tr>
                                                        <th>Wash</th>
                                                        <th>EMB</th>
                                                        <th>Print</th>
                                                        <th>Quilting</th>
                                                        <th>Other</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    <tr>
                                                        <td><input value="0.0000" /></td>
                                                        <td><input value="0.0000" /></td>
                                                        <td><input value="0.0000" /></td>
                                                        <td><input value="0.0000" /></td>
                                                        <td><input value="0.0000" /></td>
                                                    </tr>
                                                </tbody>

                                            </table>

                                        </div>


                                        <!-- Second table -->

                                        <div class="mini-cost-table">

                                            <table>

                                                <thead>
                                                    <tr>
                                                        <th>Wash Fall</th>
                                                        <th>Testing</th>
                                                        <th>Sample</th>
                                                        <th>Other</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    <tr>
                                                        <td><input value="0.0000" /></td>
                                                        <td><input value="4.2000" /></td>
                                                        <td><input value="4.2000" /></td>
                                                        <td><input value="0.0000" /></td>
                                                    </tr>
                                                </tbody>

                                            </table>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================================
             RIGHT SIDE
             ================================================= -->

                            <div class="fob-costing-right">


                                <!-- Factory Per Doz -->

                                <div class="foxpro-side-card">

                                    <div class="foxpro-side-title">
                                        Factory Per Doz
                                    </div>


                                    <div class="side-cost-row">
                                        <label>Fty SMV</label>
                                        <input type="text" />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>SMV W/Ded</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Cost/Min</label>
                                        <input type="text"  />
                                    </div>


                                    <div class="side-divider"></div>


                                    <div class="side-cost-row">
                                        <label>Neg Price</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Fixed Tr</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Hanger</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row total-side-row">
                                        <label>Total Neg</label>
                                        <input type="text"  />
                                    </div>


                                    <div class="side-divider"></div>


                                    <div class="side-cost-row">
                                        <label>Trims Per Pc</label>
                                        <input type="text" />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Trims</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Less Hanger</label>
                                        <input type="text"  />
                                    </div>


                                    <div class="side-small-select-row">

                                        <select>
                                            <option></option>
                                        </select>

                                        <input type="text" />

                                        <input type="text"  />

                                    </div>


                                    <div class="side-small-select-row">

                                        <select>
                                            <option></option>
                                        </select>

                                        <input type="text" />

                                        <input type="text"  />

                                    </div>


                                    <div class="side-cost-row">
                                        <label>Develop</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Non Quote</label>
                                        <input type="text" />
                                    </div>


                                    <div class="side-cost-row total-side-row">
                                        <label>Total Trims</label>
                                        <input type="text"  />
                                    </div>


                                    <div class="side-divider"></div>


                                    <div class="side-cost-row">
                                        <label>Laser Cut</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Pleating</label>
                                        <input type="text" />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Smocking</label>
                                        <input type="text"  />
                                    </div>

                                    <div class="side-cost-row">
                                        <label>Bonding</label>
                                        <input type="text" />
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =====================================================
         PAGE NAVIGATION
         ===================================================== -->

                        <div class="form-footer">

                            <button type="button"
                                    class="navigation-button secondary"
                                    onclick="previousPage()">
                                ← Previous
                            </button>

                            <div class="page-indicator">
                                Page <strong id="currentPage">2</strong> of 5
                            </div>

                            <button type="button"
                                    class="navigation-button primary"
                                    onclick="nextPage()">
                                Next →
                            </button>

                        </div>

                    </section>

                    <!-- =========================================================
     PAGE 3 - FOB COST & PROFIT
     ========================================================= -->

                    <section class="form-page" id="page3">

                        <div class="page-title">
                            <h2>FOB Cost & Profit</h2>
                            <p>FOB selling price, profitability and lot information.</p>
                        </div>

                        <div class="page3-foxpro-layout">

                            <!-- =================================================
             LEFT SIDE
             ================================================= -->
                            <div class="page3-left">

                                <!-- FOB MATRIX -->
                                <div class="page3-costing-box">

                                    <!-- Column headings -->
                                    <div class="page3-column-header">
                                        <div></div>
                                        <div class="fox-red-heading">AIR</div>
                                        <div class="fox-red-heading">Vessel</div>
                                        <div class="fox-red-heading">Act Fty</div>
                                        <div>
                                            <input type="text"
                                                   
                                                   class="fox-yellow-input" />
                                        </div>
