    <script>

            let currentPage = 1;

            let selectedRevision = null;


            /* =====================================================
               PAGE NAVIGATION
               ===================================================== */

            function showPage(pageNumber) {

                if (pageNumber < 1 || pageNumber > 5) {
                    return;
                }

                document
                    .querySelectorAll(".form-page")
                    .forEach(page => {
                        page.classList.remove("active-page");
                    });


                const page = document.getElementById(
                    "page" + pageNumber
                );

                if (page) {
                    page.classList.add("active-page");
                }


                document
                    .querySelectorAll(".page-tab")
                    .forEach(tab => {

                        tab.classList.remove("active");

                        if (
                            Number(tab.dataset.page) === pageNumber
                        ) {
                            tab.classList.add("active");
                        }

                    });


                currentPage = pageNumber;

                document.getElementById("currentPage").textContent =
                    pageNumber;


                const previousButton =
                    document.getElementById("previousButton");

                const nextButton =
                    document.getElementById("nextButton");


                previousButton.disabled =
                    pageNumber === 1;


                if (pageNumber === 5) {

                    nextButton.innerHTML =
                        "Finish <span>✓</span>";

                }
                else {

                    nextButton.innerHTML =
                        "Next <span>›</span>";

                }


                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            }


            function nextPage() {

                if (currentPage < 5) {

                    showPage(currentPage + 1);

                }
                else {

                    closeForm();

                }

            }


            function previousPage() {

                if (currentPage > 1) {

                    showPage(currentPage - 1);

                }

            }


            /* =====================================================
               STYLE HEADER
               ===================================================== */

            function updateHeaderStyle() {

                const style =
                    document.getElementById("styleNumber").value;

                document.getElementById("headerStyleNo").textContent =
                    style || "—";

            }


            /* =====================================================
               REVISION MODAL
               ===================================================== */

            function openRevisionModal() {

                const modal =
                    document.getElementById("revisionModal");

                modal.classList.add("show");

                modal.setAttribute("aria-hidden", "false");

                document
                    .getElementById("revisionSearchValue")
                    .focus();

            }


            function closeRevisionModal() {

                const modal =
                    document.getElementById("revisionModal");

                modal.classList.remove("show");

                modal.setAttribute("aria-hidden", "true");

            }


            function selectRevision(row) {

                document
                    .querySelectorAll(".revision-table tbody tr")
                    .forEach(item => {

                        item.classList.remove("selected");

                    });


                row.classList.add("selected");


                selectedRevision = {

                    style:
                        row.dataset.style,

                    display:
                        row.dataset.display,

                    revision:
                        row.dataset.rev,

                    ref:
                        row.dataset.ref

                };


                document.getElementById(
                    "selectedRevisionText"
                ).textContent =
                    "Selected: Style " +
                    selectedRevision.style +
                    " / Revision " +
                    selectedRevision.revision;

            }


            function applyRevision() {

                if (!selectedRevision) {

                    alert(
                        "Please select a revision first."
                    );

                    return;

                }


                document.getElementById(
                    "styleNumber"
                ).value =
                    selectedRevision.style;


                document.getElementById(
                    "displayStyle"
                ).value =
                    selectedRevision.display;


                document.getElementById(
                    "revisionNo"
                ).value =
                    selectedRevision.revision;


                document.getElementById(
                    "refNo"
                ).value =
                    selectedRevision.ref;


                document.getElementById(
                    "costingRevision"
                ).value =
                    selectedRevision.revision;


                document.getElementById(
                    "headerStyleNo"
                ).textContent =
                    selectedRevision.style;


                document.getElementById(
                    "headerRevision"
                ).textContent =
                    selectedRevision.revision;


                closeRevisionModal();

            }


            function searchRevisions() {

                const search =
                    document
                        .getElementById(
                            "revisionSearchValue"
                        )
                        .value
                        .trim()
                        .toLowerCase();


                document
                    .querySelectorAll(
                        "#revisionTableBody tr"
                    )
                    .forEach(row => {

                        const text =
                            row.textContent.toLowerCase();

                        row.style.display =
                            text.includes(search)
                                ? ""
                                : "none";

                    });

            }


            /* =====================================================
               ACTION BUTTONS
               ===================================================== */

            function updateCosting() {

                alert(
                    "Update will be connected to the existing SQL database later."
                );

            }


            function saveAsRevision() {

                alert(
                    "Save As Revision will create a new revision when SQL is connected."
                );

            }


            function updateMas() {

                alert(
                    "Update MAS will be connected to the existing MAS process later."
                );

            }


            function closeForm() {

                window.location.href =
                    "/Home/Index";

            }


            /* =====================================================
               KEYBOARD NAVIGATION
               ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "ArrowRight" &&
                        !event.target.matches("input, textarea, select")
                    ) {

                        nextPage();

                    }


                    if (
                        event.key === "ArrowLeft" &&
                        !event.target.matches("input, textarea, select")
                    ) {

                        previousPage();

                    }


                    if (event.key === "Escape") {

                        closeRevisionModal();

                    }

                }
            );


            /* =====================================================
               CLOSE MODAL WHEN CLICKING OUTSIDE
               ===================================================== */

            document
                .getElementById("revisionModal")
                .addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.target === this
                        ) {

                            closeRevisionModal();

                        }

                    }
                );


            /* =====================================================
               INITIALIZE
               ===================================================== */

            showPage(1);

    </script>

