@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>KOMAR FORMAT - FOB</title>

    <link rel="stylesheet" href="~/css/komar-fob.css" />
</head>

<body>

    <div class="fob-app">

        <!-- =========================================================
         HEADER
         ========================================================= -->

        <header class="fob-header">

            <div class="header-left">
                <div class="header-icon">K</div>

                <div>
                    <div class="header-title">
                        KOMAR FORMAT - FOB
                    </div>

                    <div class="header-subtitle">
                        Factory FOB Costing Management
                    </div>
                </div>
            </div>

            <div class="header-right">

                <div class="style-reference">
                    <span>STYLE</span>
                    <strong id="headerStyleNo">—</strong>
                </div>

                <div class="revision-reference">
                    <span>REV</span>
                    <strong id="headerRevision">—</strong>
                </div>

            </div>

        </header>


        <!-- =========================================================
         STEP NAVIGATION
         ========================================================= -->

        <nav class="page-tabs">

            <button type="button"
                    class="page-tab active"
                    data-page="1"
                    onclick="showPage(1)">

                <span class="tab-number">01</span>

                <span>
                    <strong>Style Details</strong>
                    <small>Basic information</small>
                </span>

            </button>


            <button type="button"
                    class="page-tab"
                    data-page="2"
                    onclick="showPage(2)">

                <span class="tab-number">02</span>

                <span>
                    <strong>FOB Costing</strong>
                    <small>Factory costing</small>
                </span>

            </button>


            <button type="button"
                    class="page-tab"
                    data-page="3"
                    onclick="showPage(3)">

                <span class="tab-number">03</span>

                <span>
                    <strong>FOB Cost & Profit</strong>
                    <small>Profitability</small>
                </span>

            </button>


            <button type="button"
                    class="page-tab"
                    data-page="4"
                    onclick="showPage(4)">

                <span class="tab-number">04</span>

                <span>
                    <strong>Basic Trims</strong>
                    <small>Approval & documents</small>
                </span>

            </button>


            <button type="button"
                    class="page-tab"
                    data-page="5"
                    onclick="showPage(5)">

                <span class="tab-number">05</span>

                <span>
                    <strong>Confirmation</strong>
                    <small>Styles & lots</small>
                </span>

            </button>

        </nav>


        <!-- =========================================================
         FORM BODY
         ========================================================= -->

        <main class="fob-content">


            <!-- =====================================================
             PAGE 1
             ===================================================== -->

            <section class="form-page active-page" id="page1">

                <div class="page-heading">

                    <div>
                        <span>STEP 01 OF 05</span>

                        <h1>Style Details</h1>

                        <p>
                            Enter the main style, account and fabric information.
                        </p>
                    </div>

                    <div class="page-status">
                        <span class="status-dot"></span>
                        Ready
                    </div>

                </div>


                <!-- STYLE IDENTIFICATION -->

                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">01</div>

                        <div>
                            <h2>Style Identification</h2>
                            <p>Style and costing reference information.</p>
                        </div>

                    </div>


                    <div class="form-grid four-columns">

                        <div class="field">
                            <label>Style No</label>

                            <div class="input-with-button">

                                <input id="styleNumber"
                                       type="text"
                                       autocomplete="off"
                                       oninput="updateHeaderStyle()" />

                                <button type="button"
                                        onclick="openRevisionModal()"
                                        title="Find revisions">

                                    ⋯

                                </button>

                            </div>
                        </div>


                        <div class="field">
                            <label>Create Date</label>
                            <input type="date" />
                        </div>


                        <div class="field">
                            <label>Ref #</label>
                            <input type="text" id="refNo" />
                        </div>


                        <div class="field">
                            <label>Costing</label>

                            <div class="costing-control">

                                <select id="costingStatus">

                                    <option>SIGNED</option>
                                    <option>UNSIGNED</option>
                                    <option>DRAFT</option>

                                </select>

                                <input type="text"
                                       id="costingRevision"
                                       value="00"
                                       readonly />

                            </div>
                        </div>

                    </div>


                    <div class="form-grid three-columns">

                        <div class="field span-2">
                            <label>Display Style</label>

                            <input type="text"
                                   id="displayStyle" />

                        </div>


                        <div class="field">
                            <label>Account</label>

                            <input type="text"
                                   id="account"
                                   placeholder="Account" />

                        </div>

                    </div>


                    <div class="form-grid four-columns">

                        <div class="field">
                            <label>Fabric Group</label>
                            <input type="text" />
                        </div>

                        <div class="field">
                            <label>Country</label>
                            <input type="text" value="SRI LANKA" />
                        </div>

                        <div class="field">
                            <label>Category</label>
                            <input type="text" />
                        </div>

                        <div class="field">
                            <label>Season</label>
                            <input type="text" />
                        </div>

                    </div>


                    <div class="form-grid four-columns">

                        <div class="field">
                            <label>Rev No</label>

                            <input id="revisionNo"
                                   type="text"
                                   readonly />

                        </div>

                        <div class="field span-2">
                            <label>Description</label>
                            <input type="text" />
                        </div>

                        <div class="field">
                            <label>Quote</label>
                            <input type="number" step="0.0001" />
                        </div>

                    </div>


                    <div class="form-grid four-columns">

                        <div class="field">
                            <label>X'Fty Date</label>
                            <input type="date" />
                        </div>

                        <div class="field">
                            <label>Duty Rate</label>
                            <input type="number" step="0.0001" />
                        </div>

                        <div class="field">
                            <label>FTY Duty Rate</label>
                            <input type="number" step="0.0001" />
                        </div>

                        <div class="field">
                            <label>KG Rate</label>
                            <input type="number" step="0.0001" />
                        </div>

                    </div>


                    <div class="form-grid four-columns">

                        <div class="field">
                            <label>Quote Rate</label>
                            <input type="number" step="0.0001" />
                        </div>

                        <div class="field">
                            <label>Gmts In Pack</label>
                            <input type="number" />
                        </div>

                        <div class="field">
                            <label>Brand / Label</label>
                            <input type="text" />
                        </div>

                        <div class="field">
                            <label>Color</label>
                            <input type="text" />
                        </div>

                    </div>


                    <div class="form-grid three-columns">

                        <div class="field">
                            <label>Sizes</label>
                            <input type="text" />
                        </div>


                        <div class="field">
                            <label>Projected Units</label>
                            <input type="number" />
                        </div>


                        <div class="field">

                            <label>Status</label>

                            <div class="radio-group">

                                <label class="radio-option">
                                    <input type="radio"
                                           name="styleStatus"
                                           checked />
                                    Active
                                </label>

                                <label class="radio-option">
                                    <input type="radio"
                                           name="styleStatus" />
                                    Inactive
                                </label>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FABRIC DETAILS -->

                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">02</div>

                        <div>
                            <h2>Fabric Details</h2>
                            <p>Fabric and pricing information for the style.</p>
                        </div>

                    </div>


                    <div class="table-container">

                        <table class="data-table fabric-table">

                            <thead>

                                <tr>
                                    <th>No</th>
                                    <th>Type</th>
                                    <th>Fabric</th>
                                    <th>Customer Paid</th>
                                    <th>Contract</th>
                                    <th>Price</th>
                                    <th>Fabric Content</th>
                                </tr>

                            </thead>

                            <tbody>

                                @for (int i = 1; i <= 8; i++)
                                {
                                    <tr>

                                        <td>@i</td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                        <td class="check-cell">
                                            <input type="checkbox" />
                                        </td>

                                        <td class="check-cell">
                                            <input type="checkbox" />
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                        <td>
                                            <input type="number" step="0.0001" />
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <div class="table-actions">

                        <button type="button" class="secondary-button">
                            + Add Line
                        </button>

                        <button type="button" class="secondary-button danger-soft">
                            − Delete Line
                        </button>

                    </div>

                </div>


                <!-- SKETCH -->

                <div class="section-card sketch-section">

                    <div class="sketch-preview">

                        <div class="sketch-placeholder">

                            <div class="sketch-icon">✧</div>

                            <span>Sketch Preview</span>

                            <small>No sketch loaded</small>

                        </div>

                    </div>


                    <div class="sketch-controls">

                        <button type="button" class="secondary-button">
                            Paste Sketch
                        </button>

                        <button type="button" class="secondary-button">
                            Load Sketch
                        </button>

                    </div>

                </div>

            </section>


            <!-- =====================================================
             PAGE 2 - FOB COSTING
             ===================================================== -->

            <section class="form-page" id="page2">

                <div class="page-heading">

                    <div>
                        <span>STEP 02 OF 05</span>

                        <h1>FOB Costing</h1>

                        <p>
                            Manage piecegoods, account costing and factory costing.
                        </p>
                    </div>

                    <div class="page-status">
                        <span class="status-dot"></span>
                        Costing
                    </div>

                </div>


                <div class="fob-costing-layout">

                    <!-- LEFT -->

                    <div class="costing-left">


                        <!-- ADDITIONAL -->

                        <div class="section-card">

                            <div class="section-title compact">

                                <div class="section-icon">%</div>

                                <div>
                                    <h2>Additional %</h2>
                                    <p>Additional costing percentages.</p>
                                </div>

                            </div>


                            <div class="additional-values">

                                <div class="mini-field">

                                    <label>Additional Air</label>

                                    <input type="number"
                                           step="0.0001"
                                           value="0.00" />

                                </div>


                                <div class="mini-field">

                                    <label>Additional Vessel</label>

                                    <input type="number"
                                           step="0.0001"
                                           value="0.00" />

                                </div>

                            </div>

                        </div>


                        <!-- FACTORY COSTING TABLE -->

                        <div class="section-card">

                            <div class="section-title compact">

                                <div class="section-icon">01</div>

                                <div>
                                    <h2>Factory Costing</h2>
                                    <p>Piecegoods and factory costing details.</p>
                                </div>

                            </div>


                            <div class="table-container costing-table-container">

                                <table class="data-table costing-table">

                                    <thead>

                                        <tr>

                                            <th>No</th>
                                            <th>Doz</th>
                                            <th>Pcs</th>

                                            <th class="highlight-header">
                                                Acct Air
                                            </th>

                                            <th class="highlight-header">
                                                Acct Ves
                                            </th>

                                            <th>Fty YC</th>

                                            <th>Fty Price</th>

                                            <th class="highlight-header">
                                                Fty Value
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @for (int i = 1; i <= 8; i++)
                                        {
                                            <tr>

                                                <td>@i</td>

                                                <td>
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td>
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td class="highlight-cell">
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td class="highlight-cell">
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td>
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td>
                                                    <input type="number" step="0.0001" />
                                                </td>

                                                <td class="highlight-cell">
                                                    <input type="number" step="0.0001" />
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- MAIN COSTING -->

                        <div class="section-card">

                            <div class="section-title compact">

                                <div class="section-icon">C</div>

                                <div>
                                    <h2>Main Costing</h2>
                                    <p>Core cost components by account and factory value.</p>
                                </div>

                            </div>


                            <div class="main-cost-grid">

                                <div class="main-cost-header">

                                    <div>Cost Component</div>
                                    <div>Acct Air</div>
                                    <div>Acct Ves</div>
                                    <div>Fty Value</div>

                                </div>


                                @{
                                    var costingRows = new[]
                                    {
                                    "Total Piecegoods Cost",
                                    "Labour",
                                    "Assist",
                                    "ACCT Fixed Trims",
                                    "Miscellaneous",
                                    "Washing",
                                    "Non Dutiable",
                                    "Overhead",
                                    "Trims"
                                };
                                }

                                @foreach (var row in costingRows)
                                {
                                    <div class="main-cost-row">

                                        <span>@row</span>

                                        <input type="number"
                                               step="0.0001" />

                                        <input type="number"
                                               step="0.0001" />

                                        <input class="factory-value"
                                               type="number"
                                               step="0.0001" />

                                    </div>
                                }

                            </div>


                            <div class="cost-summary">

                                <div class="summary-field">

                                    <label>FOB Value XL</label>

                                    <input type="number"
                                           step="0.0001" />

                                </div>


                                <div class="summary-fields">

                                    <label>Sub Totals</label>

                                    <input type="number" />
                                    <input type="number" />
                                    <input type="number" />
                                    <input type="number" />

                                </div>

                            </div>


                            <div class="mini-cost-tables">

                                <table>

                                    <thead>
                                        <tr>
                                            <th>Wash</th>
                                            <th>EMB</th>
                                            <th>Print</th>
                                            <th>Quilting</th>
                                            <th>Other</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                        </tr>
                                    </tbody>

                                </table>


                                <table>

                                    <thead>
                                        <tr>
                                            <th>Wash Fall</th>
                                            <th>Testing</th>
                                            <th>Sample</th>
                                            <th>Other</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                        </tr>
                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>


                    <!-- RIGHT FACTORY PER DOZ -->

                    <div class="factory-panel">

                        <div class="section-card factory-card">

                            <div class="section-title compact">

                                <div class="section-icon">F</div>

                                <div>
                                    <h2>Factory Per Doz</h2>
                                    <p>Factory-level costing values.</p>
                                </div>

                            </div>


                            <div class="factory-fields">

                                <div class="factory-field">
                                    <label>Fty SMV</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>SMV W/Ded</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Cost/Min</label>
                                    <input type="number" step="0.0001" />
                                </div>


                                <div class="factory-divider"></div>


                                <div class="factory-field">
                                    <label>Neg Price</label>
                                    <input class="yellow-input" type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Fixed Tr</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Hanger</label>
                                    <input type="number" step="0.0001" />
                                </div>


                                <div class="factory-total">
                                    <span>Total Neg</span>
                                    <input class="yellow-input" type="number" step="0.0001" />
                                </div>


                                <div class="factory-divider"></div>


                                <div class="factory-field">
                                    <label>Trims Per Pc</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Trims</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Less Hanger</label>
                                    <input type="number" step="0.0001" />
                                </div>


                                <div class="factory-extra-row">

                                    <select>
                                        <option></option>
                                    </select>

                                    <input type="text" />

                                    <input type="number" />

                                </div>


                                <div class="factory-extra-row">

                                    <select>
                                        <option></option>
                                    </select>

                                    <input type="text" />

                                    <input type="number" />

                                </div>


                                <div class="factory-field">
                                    <label>Develop</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Non Quote</label>
                                    <input type="number" step="0.0001" />
                                </div>


                                <div class="factory-total">

                                    <span>Total Trims</span>

                                    <input class="yellow-input"
                                           type="number"
                                           step="0.0001" />

                                </div>


                                <div class="factory-field">
                                    <label>Laser Cut</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Pleating</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Smocking</label>
                                    <input type="number" step="0.0001" />
                                </div>

                                <div class="factory-field">
                                    <label>Bonding</label>
                                    <input type="number" step="0.0001" />
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =====================================================
             PAGE 3
             ===================================================== -->

            <section class="form-page" id="page3">

                <div class="page-heading">

                    <div>
                        <span>STEP 03 OF 05</span>

                        <h1>FOB Cost & Profit</h1>

                        <p>
                            Review FOB selling price and profitability.
                        </p>
                    </div>

                </div>


                <div class="profit-layout">

                    <div class="section-card profit-main">

                        <div class="profit-header">

                            <div></div>

                            <div class="matrix-heading">AIR</div>

                            <div class="matrix-heading">Vessel</div>

                            <div class="matrix-heading">Act Fty</div>

                            <div class="matrix-heading">FOB</div>

                        </div>


                        @{
                            var profitRows = new[]
                            {
                            "Sub Totals",
                            "Acct Surchg Qty",
                            "Acct Quota Chg",
                            "Freight Warehouse",
                            "Duty",
                            "NDT Value Add Services"
                        };
                        }

                        @foreach (var row in profitRows)
                        {
                            <div class="profit-row">

                                <span>@row</span>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>
                        }


                        <div class="selling-price-row">

                            <strong>FOB Selling Price</strong>

                            <input type="number" />
                            <input type="number" />
                            <input type="number" />
                            <input type="number" />

                        </div>


                        <div class="profit-work-area">
                        </div>

                    </div>


                    <div class="profit-side">

                        <div class="section-card">

                            <div class="profit-fields">

                                <div>
                                    <label>Profit %</label>
                                    <input type="number" />
                                    <input type="number" />
                                </div>

                                <div>
                                    <label>P.P Minute</label>
                                    <input type="number" />
                                    <input type="number" />
                                </div>

                                <div>
                                    <label>CFMD Date</label>
                                    <input type="date" />
                                </div>

                                <div>
                                    <label>Gross Profit</label>
                                    <input type="number" />
                                    <input type="number" />
                                </div>

                                <div>
                                    <label>Profit Margin</label>
                                    <input type="number" />
                                    <input type="number" />
                                </div>

                            </div>

                        </div>


                        <div class="section-card lots-card">

                            <h3>LDP Lots</h3>

                            <table class="data-table">

                                <thead>
                                    <tr>
                                        <th>Lots</th>
                                        <th>Doz</th>
                                        <th>Pcs</th>
                                        <th>Tot Pcs</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @for (int i = 0; i < 6; i++)
                                    {
                                        <tr>
                                            <td><input type="text" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <div class="section-card lots-card">

                            <h3>FOB Lots</h3>

                            <table class="data-table">

                                <thead>
                                    <tr>
                                        <th>Lots</th>
                                        <th>Doz</th>
                                        <th>Pcs</th>
                                        <th>Tot Pcs</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @for (int i = 0; i < 6; i++)
                                    {
                                        <tr>
                                            <td><input type="text" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =====================================================
             PAGE 4
             ===================================================== -->

            <section class="form-page" id="page4">

                <div class="page-heading">

                    <div>
                        <span>STEP 04 OF 05</span>

                        <h1>Basic Trims</h1>

                        <p>
                            Manage trims, approvals and supporting documents.
                        </p>
                    </div>

                </div>


                <div class="section-card">

                    <div class="section-title">

                        <div class="section-icon">04</div>

                        <div>
                            <h2>Basic Trims</h2>
                            <p>Trim details associated with this costing.</p>
                        </div>

                    </div>


                    <div class="table-container large-table">

                        <table class="data-table trims-table">

                            <thead>

                                <tr>
