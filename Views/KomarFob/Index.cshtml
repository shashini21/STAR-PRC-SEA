        <script>

                    /* =========================================================
                       PAGE NAVIGATION
                       ========================================================= */

                    let currentPage = 1;

                    const totalPages = 5;

                    let selectedRevision = null;


                    function showPage(pageNumber) {
                        if (pageNumber < 1 || pageNumber > totalPages) {
                            return;
                        }


                        currentPage = pageNumber;


                        document
                            .querySelectorAll(".form-page")
                            .forEach(function(page) {
                                page.classList.remove("active-page");
                            });


                        document
                            .getElementById("page" + pageNumber)
                            .classList.add("active-page");


                        document
                            .querySelectorAll(".page-tab")
                            .forEach(function(tab, index) {
                                tab.classList.remove("active");

                                if (index + 1 === pageNumber) {
                                    tab.classList.add("active");
                                }
                            });


                        document.getElementById("currentPage")
                            .textContent = pageNumber;


                        document.getElementById("previousButton")
                            .disabled = pageNumber === 1;


                        if (pageNumber === totalPages) {
                            document.getElementById("nextButton")
                                .textContent = "Finish ✓";
                        }
                        else {
                            document.getElementById("nextButton")
                                .textContent = "Next →";
                        }


                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    }


                    function nextPage() {
                        if (currentPage < totalPages) {
                            showPage(currentPage + 1);
                        }
                    }


                    function previousPage() {
                        if (currentPage > 1) {
                            showPage(currentPage - 1);
                        }
                    }


                    /* =========================================================
                       REVISION MODAL
                       ========================================================= */

                    function openRevisionModal() {
                        const styleNumber =
                            document
                                .getElementById("styleNumber")
                                .value
                                .trim();


                        if (styleNumber === "") {
                            alert(
                                "Please enter a style number first."
                            );

                            document
                                .getElementById("styleNumber")
                                .focus();

                            return;
                        }


                        document
                            .getElementById("revisionSearchValue")
                            .value = styleNumber;


                        document
                            .getElementById("revisionModal")
                            .classList.add("show");


                        selectedRevision = null;


                        document
                            .querySelectorAll(
                                ".revision-table tbody tr"
                            )
                            .forEach(function(row) {
                                row.classList.remove("selected");
                            });
                    }


                    function closeRevisionModal() {
                        document
                            .getElementById("revisionModal")
                            .classList.remove("show");
                    }


                    function selectRevision(row) {
                        document
                            .querySelectorAll(
                                ".revision-table tbody tr"
                            )
                            .forEach(function(item) {
                                item.classList.remove("selected");
                            });


                        row.classList.add("selected");


                        const cells =
                            row.querySelectorAll("td");


                        selectedRevision =
                        {
                            styleCode:
                                cells[0].textContent.trim(),

                            displayStyle:
                                cells[1].textContent.trim(),

                            type:
                                cells[2].textContent.trim(),

                            revisionNo:
                                cells[3].textContent.trim(),

                            refNo:
                                cells[4].textContent.trim(),

                            createDate:
                                cells[11].textContent.trim()
                        };
                    }


                    function loadSelectedRevision() {
                        if (!selectedRevision) {
                            alert(
                                "Please select a revision to modify."
                            );

                            return;
                        }


                        document
                            .getElementById("styleNumber")
                            .value =
                            selectedRevision.styleCode;


                        document
                            .getElementById("displayStyle")
                            .value =
                            selectedRevision.displayStyle;


                        document
                            .getElementById("revisionNo")
                            .value =
                            selectedRevision.revisionNo;


                        document
                            .getElementById("refNo")
                            .value =
                            selectedRevision.refNo;


                        document
                            .getElementById("costingRevision")
                            .value =
                            selectedRevision.revisionNo;


                        document
                            .getElementById("costingStatus")
                            .value =
                            "SIGNED";


                        closeRevisionModal();
                    }


                    function searchRevisions() {
                        alert(
                            "SQL revision search will be connected later."
                        );
                    }


                    /* =========================================================
                       FORM ACTIONS
                       ========================================================= */

                    function updateCosting() {
                        alert(
                            "Update will be connected to SQL later."
                        );
                    }


                    function saveAsRevision() {
                        alert(
                            "Save As Revision will be connected later."
                        );
                    }


                    function updateMas() {
                        alert(
                            "Update MAS will be connected later."
                        );
                    }


                    function closeForm() {
                        window.location.href =
                            "/Home/Index";
                    }


                    /* =========================================================
                       MODAL OUTSIDE CLICK
                       ========================================================= */

                    document
                        .getElementById("revisionModal")
                        .addEventListener(
                            "click",
                            function(event) {
                                if (event.target === this) {
                                    closeRevisionModal();
                                }
                            }
                        );


                    /* =========================================================
                       KEYBOARD NAVIGATION
                       ========================================================= */

                    document.addEventListener(
                        "keydown",
                        function(event) {
                            if (
                                event.key === "ArrowRight" &&
                                currentPage < totalPages
                            ) {
                                nextPage();
                            }


                            if (
                                event.key === "ArrowLeft" &&
                                currentPage > 1
                            ) {
                                previousPage();
                            }


                            if (event.key === "Escape") {
                                closeRevisionModal();
                            }
                        }
                    );


                    showPage(1);

        </script>

    </body>

</html>