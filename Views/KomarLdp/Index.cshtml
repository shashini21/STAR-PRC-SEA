@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>KOMAR FORMAT - LDP</title>

    <link rel="stylesheet"
          href="/css/komar-ldp.css?v=1" />

</head>

<body>

    <div class="page-container">

        <div class="komar-card">


            <!-- =====================================================
             HEADER
             ===================================================== -->

            <div class="komar-header">

                <div class="header-left">

                    <div class="header-icon">
                        K
                    </div>

                    <div>

                        <div class="header-breadcrumb">
                            TRANSACTION FILES
                        </div>

                        <h1>
                            KOMAR FORMAT - LDP
                        </h1>

                        <p>
                            Costing and style management
                        </p>

                    </div>

                </div>


                <button type="button"
                        class="header-close"
                        onclick="closeForm()">

                    ×

                </button>

            </div>


            <!-- =====================================================
             PAGE NAVIGATION
             ===================================================== -->

            <div class="page-navigation">

                <button type="button"
                        class="page-tab active"
                        onclick="showPage(1)">

                    <span class="page-number">
                        01
                    </span>

                    <span>
                        Style
                    </span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(2)">

                    <span class="page-number">
                        02
                    </span>

                    <span>
                        Costing
                    </span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(3)">

                    <span class="page-number">
                        03
                    </span>

                    <span>
                        Profit
                    </span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(4)">

                    <span class="page-number">
                        04
                    </span>

                    <span>
                        Trims
                    </span>

                </button>


                <button type="button"
                        class="page-tab"
                        onclick="showPage(5)">

                    <span class="page-number">
                        05
                    </span>

                    <span>
                        Styles
                    </span>

                </button>

            </div>


            <!-- =====================================================
             PAGE CONTENT
             ===================================================== -->

            <div class="page-content">


                <!-- =================================================
                 PAGE 1
                 ================================================= -->

                <section class="form-page active-page"
                         id="page1">


                    <div class="page-title">

                        <div>

                            <h2>
                                Style Information
                            </h2>

                            <p>
                                Enter the basic style and order information.
                            </p>

                        </div>

                    </div>


                    <!-- BASIC INFORMATION -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                01
                            </span>

                            <div>

                                <h3>
                                    Basic Information
                                </h3>

                                <p>
                                    Style and costing reference details
                                </p>

                            </div>

                        </div>


                        <div class="form-grid">


                            <div class="form-field">

                                <label>
                                    Style No
                                </label>

                                <input type="text"
                                       id="styleCode"
                                       placeholder="Enter style number" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Create Date
                                </label>

                                <input type="date"
                                       id="createDate" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Ref #
                                </label>

                                <input type="text"
                                       placeholder="Enter reference" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Costing Type
                                </label>

                                <select>

                                    <option>
                                        Select costing type
                                    </option>

                                </select>

                            </div>


                            <div class="form-field wide">

                                <label>
                                    Display Style
                                </label>

                                <input type="text"
                                       placeholder="Enter display style" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Season
                                </label>

                                <select>

                                    <option>
                                        Select season
                                    </option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>
                                    Account
                                </label>

                                <input type="text"
                                       placeholder="Enter account" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Category
                                </label>

                                <select>

                                    <option>
                                        Select category
                                    </option>

                                </select>

                            </div>


                            <div class="form-field">

                                <label>
                                    FOB Style
                                </label>

                                <input type="text"
                                       placeholder="Enter FOB style" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Account Name
                                </label>

                                <input type="text"
                                       placeholder="Account name" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Fabric Group
                                </label>

                                <input type="text"
                                       placeholder="Fabric group" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Quote
                                </label>

                                <input type="text"
                                       placeholder="Quote" />

                            </div>


                            <div class="form-field">

                                <label>
                                    X'Fty Date
                                </label>

                                <input type="date" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Description
                                </label>

                                <input type="text"
                                       placeholder="Description" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Rev No
                                </label>

                                <input type="text"
                                       placeholder="Revision number" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Gmts In a Pack
                                </label>

                                <input type="number"
                                       placeholder="0" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Duty Rate
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Fty Duty Rate
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    KG Rate
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    KG Weight
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Projected Units
                                </label>

                                <input type="number"
                                       placeholder="0" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Brand / Label
                                </label>

                                <input type="text"
                                       placeholder="Brand / Label" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Color
                                </label>

                                <input type="text"
                                       placeholder="Color" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Sizes
                                </label>

                                <input type="text"
                                       placeholder="Sizes" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Country
                                </label>

                                <input type="text"
                                       placeholder="Country" />

                            </div>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="section-card">

                        <div class="status-section">

                            <span class="status-label">
                                Style Status
                            </span>


                            <label class="radio-option">

                                <input type="radio"
                                       name="styleStatus"
                                       checked />

                                <span>
                                    Active
                                </span>

                            </label>


                            <label class="radio-option">

                                <input type="radio"
                                       name="styleStatus" />

                                <span>
                                    Inactive
                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- FABRIC TABLE -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                02
                            </span>

                            <div>

                                <h3>
                                    Fabric Details
                                </h3>

                                <p>
                                    Fabric and customer payment information
                                </p>

                            </div>

                        </div>


                        <div class="data-table-wrapper">

                            <table class="data-table">

                                <thead>

                                    <tr>

                                        <th>No</th>

                                        <th>Type</th>

                                        <th>Fabric</th>

                                        <th>Customer Paid</th>

                                        <th>Contract</th>

                                        <th>Price</th>

                                        <th>Fabric Content</th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <tr>

                                        <td>
                                            1
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                        <td class="center">
                                            <input type="checkbox" />
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                        <td>
                                            <input type="number" />
                                        </td>

                                        <td>
                                            <input type="text" />
                                        </td>

                                    </tr>


                                    <tr>
                                        <td>2</td>
                                        <td><input type="text" /></td>
                                        <td><input type="text" /></td>
                                        <td class="center"><input type="checkbox" /></td>
                                        <td><input type="text" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="text" /></td>
                                    </tr>


                                    <tr>
                                        <td>3</td>
                                        <td><input type="text" /></td>
                                        <td><input type="text" /></td>
                                        <td class="center"><input type="checkbox" /></td>
                                        <td><input type="text" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="text" /></td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <div class="table-actions">

                            <button type="button"
                                    class="secondary-button">

                                + Add Line

                            </button>


                            <button type="button"
                                    class="danger-outline-button">

                                − Delete Line

                            </button>

                        </div>

                    </div>


                    <!-- SKETCH -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                03
                            </span>

                            <div>

                                <h3>
                                    Style Sketch
                                </h3>

                                <p>
                                    Upload or view the style sketch.
                                </p>

                            </div>

                        </div>


                        <div class="sketch-area">

                            <div class="sketch-placeholder">

                                <div class="sketch-icon">
                                    +
                                </div>

                                <strong>
                                    No sketch uploaded
                                </strong>

                                <span>
                                    Add a style sketch later
                                </span>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                 PAGE 2
                 ================================================= -->

                <section class="form-page"
                         id="page2">


                    <div class="page-title">

                        <div>

                            <h2>
                                Costing Details
                            </h2>

                            <p>
                                Configure additional costs, SMV and production values.
                            </p>

                        </div>

                    </div>


                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                %
                            </span>

                            <div>

                                <h3>
                                    Additional Cost
                                </h3>

                                <p>
                                    Additional percentages and production values
                                </p>

                            </div>

                        </div>


                        <div class="form-grid">

                            <div class="form-field">

                                <label>
                                    Additional %
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Fty SMV
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    SMV W/Ded
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Cost / Min
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Neg Price
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Fixed Tr
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Hanger
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>


                            <div class="form-field">

                                <label>
                                    Total Neg
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="0.00" />

                            </div>

                        </div>

                    </div>


                    <!-- COST SUMMARY -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                $
                            </span>

                            <div>

                                <h3>
                                    Cost Summary
                                </h3>

                                <p>
                                    Piece goods, labour, trims and other costs
                                </p>

                            </div>

                        </div>


                        <div class="cost-grid">


                            <div class="cost-group">

                                <h4>
                                    Piecegoods Cost
                                </h4>

                                <div class="cost-row">
                                    <label>Total Piecegoods Cost</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Yellow Poly Bag CHG</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Labor</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Assist</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Acct Surchg Qty</label>
                                    <input type="number" />
                                </div>

                            </div>


                            <div class="cost-group">

                                <h4>
                                    Trims & Other
                                </h4>

                                <div class="cost-row">
                                    <label>Acct Fixed Trims</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Miscellaneous</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Wash Cost</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>PLUS Fabric Finance</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Trims</label>
                                    <input type="number" />
                                </div>

                            </div>


                            <div class="cost-group">

                                <h4>
                                    Factory Costs
                                </h4>

                                <div class="cost-row">
                                    <label>Fty SMV</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Cost / Min</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Neg Price</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Fixed Tr</label>
                                    <input type="number" />
                                </div>

                                <div class="cost-row">
                                    <label>Hanger</label>
                                    <input type="number" />
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SMALL TABLE -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                04
                            </span>

                            <div>

                                <h3>
                                    Additional Cost Details
                                </h3>

                            </div>

                        </div>


                        <div class="data-table-wrapper">

                            <table class="data-table compact">

                                <thead>

                                    <tr>

                                        <th>No</th>
                                        <th>Doz</th>
                                        <th>Pcs</th>
                                        <th>Acct Air</th>
                                        <th>Acct Ves</th>
                                        <th>Fty YC</th>
                                        <th>Fty Price</th>
                                        <th>Fty Value</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <tr>

                                        <td>1</td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                        <td><input type="number" /></td>

                                    </tr>

                                    <tr>
                                        <td>2</td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                        <td><input type="number" /></td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                 PAGE 3
                 ================================================= -->

                <section class="form-page"
                         id="page3">


                    <div class="page-title">

                        <div>

                            <h2>
                                Cost & Profit
                            </h2>

                            <p>
                                Review costing, selling price and profitability.
                            </p>

                        </div>

                    </div>


                    <!-- COSTING MATRIX -->

                    <div class="section-card">

                        <div class="section-heading">

                            <span class="section-icon">
                                $
                            </span>

                            <div>

                                <h3>
                                    Costing Matrix
                                </h3>

                                <p>
                                    Compare AIR, Vessel and Factory costing
                                </p>

                            </div>

                        </div>


                        <div class="costing-matrix">


                            <div class="matrix-header">

                                <div></div>

                                <div>
                                    AIR
                                </div>

                                <div>
                                    Vessel
                                </div>

                                <div>
                                    Act Fty
                                </div>

                                <div>
                                    Fty
                                </div>

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Sub Totals
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Duty
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    KG Weight
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Freight
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Landed Cost
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Acct Surchg Qty
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Truck Handling
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Acct Quota Chg
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    NDT Value Addition
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row">

                                <strong>
                                    Discount
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>


                            <div class="matrix-row selling-price">

                                <strong>
                                    Selling Price
                                </strong>

                                <input type="number" />
                                <input type="number" />
                                <input type="number" />
                                <input type="number" />

                            </div>

                        </div>

                    </div>


                    <!-- PROFIT -->

                    <div class="two-column-section">


                        <div class="section-card">

                            <div class="section-heading">

                                <span class="section-icon">
                                    %
                                </span>

                                <div>

                                    <h3>
                                        Profitability
                                    </h3>

                                </div>

                            </div>


                            <div class="form-grid two">

                                <div class="form-field">

                                    <label>
                                        Profit %
                                    </label>

                                    <input type="number"
                                           step="0.01" />

                                </div>


                                <div class="form-field">

                                    <label>
                                        P.P. Min
                                    </label>

                                    <input type="number"
                                           step="0.01" />

                                </div>


                                <div class="form-field">

                                    <label>
                                        Confirmed Date
                                    </label>

                                    <input type="date" />

                                </div>


                                <div class="form-field">

                                    <label>
                                        Gross Profit
                                    </label>

                                    <input type="number"
                                           step="0.01" />

                                </div>


                                <div class="form-field">

                                    <label>
                                        Profit Margin
                                    </label>

                                    <input type="number"
                                           step="0.01" />

                                </div>

                            </div>

                        </div>


                        <div class="section-card">

                            <div class="section-heading">

                                <span class="section-icon">
                                    L
                                </span>

                                <div>

                                    <h3>
                                        LDP Lots
                                    </h3>

                                </div>

                            </div>


                            <div class="mini-table">

                                <table class="data-table">

                                    <thead>

                                        <tr>
                                            <th>Lots</th>
                                            <th>Doz</th>
                                            <th>Pcs</th>
                                            <th>Tot Pcs</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        <tr>
                                            <td><input type="text" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                            <td><input type="number" /></td>
                                        </tr>

